<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.evgenybaulin.GlassWork.Keeper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/GlassWork</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.evgenybaulin.GlassWork</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GW_KEEPER</key>
		<string>1</string>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
